# Supabase (Project Settings > API) — chave publicável/anon, pode ser pública
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Chave de servidor: valor de public.app_settings.server_key (gerado pela migração).
# NUNCA exponha no cliente. Sem ela, scans/ativação/portal não funcionam.
APP_SERVER_KEY=

# URL pública de produção (usada nos QR Codes impressos e na gravação NFC)
NEXT_PUBLIC_APP_URL=https://seu-dominio.com.br

# WhatsApp do suporte/financeiro (só dígitos, com DDI) — tela de placa suspensa
NEXT_PUBLIC_SUPPORT_WHATSAPP=5511999999999

# Opcional: webhook (n8n/Make/Zapier) chamado a cada feedback negativo
FEEDBACK_WEBHOOK_URL=
